---
// The Home's row of technology companies (V2.5: the body of "Instituições e fontes", whose heading the page sets): their
// marks and nothing else, straight on the page's white, in the owner's order (lib/home-brands.ts). No card, no border,
// no shadow, no rounded box, no background, no panel; and nothing on a mark: each is the supplied file in its own
// colours (ProviderMark, unmodified), with no filter, fade or layer over it.
// A company that has published courses (read from the catalogue by lib/home-brands.ts, never typed) is a link to them,
// the track that holds its first course or the search filtered by it, with the real count of its courses under the
// mark. A company with none published is its mark alone: no link, no count, nothing that suggests a resource is
// available; the page's heading and line say they are being checked (while none has a course) and the note says a mark
// is no tie with the Paulex Edu. These are sources, never partners or sponsors, and verify-dist rejects any claim of
// association. The institutions that publish today stay in the catalogue and on their pages; this row is not their
// list.
// One row from 1024px. Below it the same marks wrap (three a row on a tablet, two on a phone) instead of scrolling or
// shrinking: nothing is hidden, a mark is never smaller than its slot allows, and no scrolling region without anything to
// focus is left to a keyboard. Only a link takes focus, and its ring is the site's own.
import ProviderMark from './ProviderMark.astro';
import type { HomeBrandCell } from '../lib/home-brands';
import { brandMarks } from '../lib/providers';
import { routes } from '../lib/routes';
import { pt as t } from '../i18n/pt';

interface Props { brands: HomeBrandCell[] }
const { brands } = Astro.props;
const s = t.home.sources;
// A company without its mark would be a blank in the row: fail the build instead.
const markOf = (id: string) => {
  const found = brandMarks[id];
  if (!found) throw new Error(`OfficialSources: ${id} has no mark`);
  return found;
};
const label = (source: NonNullable<HomeBrandCell['source']>) =>
  source.areas.length === 1 ? s.count(source.count, source.areas[0]!) : s.countAreas(source.count, source.areas);
---
<div class="sources">
  <ul class="marks" role="list">
    {brands.map((brand) => (
      <li data-institution={brand.name}>
        {brand.source ? (
          <a href={brand.source.href}>
            <span class="mark"><ProviderMark name={brand.name} marks={markOf(brand.id)} /></span>
            <span class="count">{label(brand.source)}{' '}<span class="go" aria-hidden="true">→</span></span>
          </a>
        ) : (
          <span class="mark"><ProviderMark name={brand.name} marks={markOf(brand.id)} /></span>
        )}
      </li>
    ))}
  </ul>
  <p class="note">{s.note}</p>
  <p class="exams">
    {s.exams}{' '}
    <a href={`${routes.objective('enem')}#pratique`}>{s.examLinks.enem}</a>
    {' · '}
    <a href={routes.objective('uerj')}>{s.examLinks.uerj}</a>
  </p>
</div>

<style>
  .sources { display: grid; gap: var(--space-4); }

  /* Two a row on a phone, three on a tablet, six from 1024px, evenly spread and centred. Space, not boxes. */
  .marks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    justify-items: center;
    gap: var(--space-6) var(--space-4);
    padding-block: var(--space-4);
  }
  @media (min-width: 600px) { .marks { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .marks { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-5) var(--space-3); } }

  /* One slot for every mark, so they sit on one line whatever their shape (a count under a mark hangs below the line and
     moves nothing); --bs scales them with the width. */
  .marks li { display: flex; justify-content: center; width: 100%; min-width: 0; }
  .mark { display: flex; align-items: center; justify-content: center; min-height: 4.5rem; min-width: 0; }
  .mark :global(.brand) { --bs: 1; }
  /* The narrowest phones (320px): two a row leave 136px, so the widest wordmark is scaled to fit its cell. */
  @media (max-width: 379px) { .mark :global(.brand) { --bs: 0.85; } }
  @media (min-width: 1024px) { .mark :global(.brand) { --bs: 0.85; } }
  @media (min-width: 1200px) { .mark :global(.brand) { --bs: 1; } }

  /* A mark that leads to courses: the mark, the count under it, and nothing that makes a box (a colour on the count). */
  .marks a { display: grid; justify-items: center; gap: var(--space-2); text-align: center; text-decoration: none; color: var(--ink); }
  .marks a:focus-visible { outline-offset: 6px; }
  .count { font-size: 0.8125rem; line-height: 1.4; color: var(--muted); text-wrap: balance; max-width: 16ch; }
  .go { display: inline-block; transition: transform var(--t-ui) var(--ease); }
  .marks a:hover .count { color: var(--action); }
  .marks a:hover .go { transform: translateX(2px); }

  .note, .exams { margin-inline: auto; text-align: center; font-size: var(--fs-small); color: var(--muted); text-wrap: balance; }
  .note { max-width: 64ch; }
  .exams { max-width: 90ch; }
  .exams a { font-weight: 500; }
</style>
