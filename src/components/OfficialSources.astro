---
// The institutions whose free courses the Academy points to (Home V2.4: the body of "Instituições e fontes", whose
// heading the page sets), as one row of equal cards after the Cursor reference, in the Paulex Edu's own light
// system: each institution's own supplied mark (ProviderMark, unmodified, in its own colours: nothing filters,
// fades or covers it), centred in a slot of one height for all, and under it the real count of its courses.
// A card leads to its courses on this site: the track that holds its first course, or, when its courses span pages,
// the search filtered by that institution (homeSources). Only providers with published, verified resources appear
// (institutions()); the brands still being verified are recorded in docs/superpowers/research/2026-10-11-official-brands.md
// and are not shown. These are the sources of the courses, never partners or sponsors: the note under the row says
// the names and marks are theirs and that the card opens the courses here, and verify-dist rejects any claim of
// association.
// One row from 1024px (as many equal cards as there are institutions, never wider than 12rem). Below it, a sideways
// row of cards (native scroll, snapping to a card), the next one always showing a little so the row reads as
// continuing, with the cue under it. No script, no auto-advance: every card is a link that takes focus, and focus
// scrolls the row to it.
import ProviderMark from './ProviderMark.astro';
import { homeSources } from '../lib/home-sources';
import { publishedResources } from '../lib/learning-resources';
import { providerMarks } from '../lib/providers';
import { routes } from '../lib/routes';
import { publishedTracks } from '../lib/tech-tracks';
import { pt as t } from '../i18n/pt';

const s = t.home.sources;
// One page: the track that holds the first course. Several pages: the search filtered by the institution.
const list = homeSources(Object.keys(providerMarks), publishedResources, publishedTracks()).map((source) => ({
  ...source,
  joint: (providerMarks[source.provider]?.length ?? 0) > 1,
  label: source.areas.length === 1 ? s.count(source.count, source.areas[0]!) : s.countAreas(source.count, source.areas),
}));
---
<div class="sources">
  <ul class="marks" role="list">
    {list.map((item) => (
      <li data-institution={item.provider}>
        <a href={item.href}>
          <span class:list={['mark', item.joint && 'joint']}><ProviderMark name={item.provider} /></span>
          <span class="count">{item.label}{' '}<span class="go" aria-hidden="true">→</span></span>
        </a>
      </li>
    ))}
  </ul>
  <p class="swipe" aria-hidden="true">{s.swipe} <span>→</span></p>
  <p class="note">{s.note}</p>
  <p class="exams">
    {s.exams}{' '}
    <a href={`${routes.objective('enem')}#pratique`}>{s.examLinks.enem}</a>
    {' · '}
    <a href={routes.objective('uerj')}>{s.examLinks.uerj}</a>
  </p>
</div>

<style>
  .sources { display: grid; gap: var(--space-3); }

  /* A phone: a sideways row, the third card showing a little. A tablet: cards of 11rem. From 1024px: one row. */
  .marks {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 44%;
    gap: var(--space-3);
    margin-inline: calc(-1 * var(--gutter));
    /* Room for the focus ring, which an overflow container would otherwise cut. */
    padding: 6px var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .marks::-webkit-scrollbar { display: none; }
  .marks > li { scroll-snap-align: start; }
  @media (min-width: 600px) { .marks { grid-auto-columns: 11rem; } }
  @media (min-width: 1024px) {
    .marks { grid-auto-columns: minmax(0, 12rem); justify-content: center; margin-inline: 0; padding: 0; overflow: visible; }
  }

  /* One card: white, a hairline, the mark centred in a slot of one height for all, the count under it. */
  .marks a {
    display: grid;
    grid-template-rows: 4.75rem auto;
    justify-items: center;
    align-content: start;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-4) var(--space-3);
    text-align: center;
    text-decoration: none;
    color: var(--ink);
    background: var(--raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    transition: border-color var(--t-ui), background var(--t-ui);
  }
  .marks a:hover { border-color: var(--action); background: var(--surface); }
  .marks a:focus-visible { outline-offset: 2px; }
  @media (min-width: 1200px) { .marks a { padding-inline: var(--space-4); } }

  /* The slot: every mark is centred in it, so the counts under them start on one line. Each mark keeps the optical
     size the catalogue gives it (providers.ts), scaled by --bs with the width of the card. */
  .mark { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; }
  .mark :global(.brand) { --bs: 0.8; }
  .mark.joint :global(.brand) { --bs: 0.7; flex-direction: column; justify-content: center; }
  @media (min-width: 600px) { .mark :global(.brand) { --bs: 0.9; } .mark.joint :global(.brand) { --bs: 0.8; } }
  @media (min-width: 1024px) { .mark :global(.brand) { --bs: 0.85; } .mark.joint :global(.brand) { --bs: 0.78; } }
  @media (min-width: 1200px) { .mark :global(.brand) { --bs: 0.95; } .mark.joint :global(.brand) { --bs: 0.85; } }

  .count { font-size: 0.8125rem; line-height: 1.4; color: var(--muted); text-wrap: balance; }
  .go { display: inline-block; transition: transform var(--t-ui) var(--ease); }
  .marks a:hover .count { color: var(--action); }
  .marks a:hover .go { transform: translateX(2px); }

  .swipe { display: flex; align-items: center; justify-content: center; gap: var(--space-2); font-size: 0.8125rem; font-weight: 560; color: var(--muted); }
  @media (min-width: 1024px) { .swipe { display: none; } }
  .note, .exams { margin-inline: auto; text-align: center; font-size: var(--fs-small); color: var(--muted); text-wrap: balance; }
  .note { max-width: 64ch; margin-top: var(--space-2); }
  .exams { max-width: 90ch; }
  .exams a { font-weight: 500; }
</style>
