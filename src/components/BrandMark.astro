---
// The Paulex Edu wordmark: "Paulex" in the navy, "Edu" in the primary blue, both in Google Sans Flex. It is
// type, not a drawing: no mark is invented for the brand.
// The official mascot (a minimal character in a navy circle) goes beside it once its file exists at
// src/assets/brand/paulex-mascot.svg (or .png): the glob below finds it at build time, and the mascot appears
// in every header and footer with nothing else to change. Until then the wordmark stands alone (see
// src/assets/brand/manifest.json, mascot.status).
// Decorative inside a link that is named on its own (the header's "Paulex Edu, página inicial"); in the
// footer it is the brand's name, read as text.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props { size?: 'header' | 'footer' }
const { size = 'header' } = Astro.props;
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/brand/paulex-mascot.{svg,png}', { eager: true });
const mascot = Object.values(found)[0]?.default;
const px = size === 'footer' ? 44 : 34;
---
<span class:list={['wordmark', `is-${size}`]} data-wordmark translate="no">
  {mascot && <Image class="mascot" src={mascot} alt="" width={px} height={px} densities={[1, 2, 3]} data-mascot />}
  <span class="name"><span class="paulex">Paulex</span><span class="edu">Edu</span></span>
</span>

<style>
  .wordmark { display: inline-flex; align-items: center; gap: 0.5rem; line-height: 1; white-space: nowrap; }
  .mascot { display: block; flex: none; border-radius: 50%; }
  .name { display: inline-flex; align-items: baseline; gap: 0.22em; font-family: var(--sans); letter-spacing: -0.025em; }
  .paulex { font-weight: 700; color: var(--brand); }
  .edu { font-weight: 500; color: var(--action); }
  .is-header .name { font-size: 1.4375rem; }
  .is-footer .name { font-size: 1.75rem; }
</style>
